---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE=
 [
    {
        date:"Febrero 2024 -  Junio 2025",
        title:"Full stack development",
        company:"Homoeonic",
        description:" Desarrollé y mantuve aplicaciones web y software de escritorio para facilitar la gestión y la venta de productos homeopáticos, centrándome en las partes front-end y back-end, así como en las mejoras de las aplicaciones."
    },
    {
        date:"Abril -  Agosto 2025",
        title:"Practicante",
        company:"G-global",
        description:"Desarrollo de un Centro de ayuda para el sistema WMS. Realizado como parte de unas prácticas profesionales."
    }
    ,{
        date:"Agosto - Diciembre 2023",
        title:"Praticante",
        company:"C4(Centro de control, Comando, Comunicacion y Computo)",
        description:"Desarrollo de un sistema de gestión de inventario de equipos de radio para el centro C4. Realizado en el marco de unas prácticas profesionales."
    }
