---
interface Props{
    id:string
    title:string,
    description:string,
    image:string,
    category:string,
    category_color:string,
    date:string
}

const {id,title,description,image,category,category_color,date}=Astro.props

---

<div 
class="group cursor-pointer"
>
    <div
     class="w-full h-56 rounded-2xl mb-4 transition-transform duration-300 group-hover:scale-[1.02]"
     style={`background-image:url(${image})`}
    />
    <a href={`/article/${id}`} style="display:block;text-decoration: none;color:inherit;">
         
      <div class={`text-sm font-semibold mb-3 text-${category_color}-600`}>
       {category}  <span class="text-gray-300 font-semibold text-base">{date}</span>
      </div>

      <h2 class="text-2xl font-bold text-white mb-3 leading-tight">
        {title}
      </h2>

      <p class="text-gray-300 leading-relaxed text-base">
       {description}
      </p>
    </a>
</div>
